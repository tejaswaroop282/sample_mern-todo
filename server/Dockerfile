# Builds the Express API in server/. No secrets are baked into the image: pass them as environment variables at run time.
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --chown=node:node . .
USER node
EXPOSE 5000
CMD ["node", "src/index.js"]
